<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Renderer of the `crm_mobile_pipeline` view (CrmMobilePipeline).

        Desktop, and every grouping other than a non-empty grouping by stage on a small screen
        (`isMobilePipeline` false), renders the standard `web.KanbanRenderer` through `t-call`, so
        their DOM is exactly the kanban DOM.

        The mobile markup shows one stage at a time:
        - The root keeps `o_kanban_renderer o_renderer o_kanban_grouped`: the upstream mobile main
          flow targets `.o_kanban_renderer`, and the base kanban controller restores the scroll of
          `.o_renderer` without a null guard.
        - The displayed stage is the only `.o_kanban_group` in the DOM. It carries the group's
          `data-id` and never `o_column_folded`, so the base controller saves and restores its
          scroll. It hosts the framework quick create (`.o_kanban_quick_create`, `.o_kanban_add`)
          when New opened it in this stage, and the cards (`.o_kanban_record`, name in a span).
        - Placement and totals come from the renderer's derived getters (pending-aware), never from
          state stored by the template.
        - Previous is not rendered on the first stage, nor Next on the last one. When the one that
          disappears held the focus, the renderer moves the focus to the first header control
          (the remaining navigation button, else Add), never to the document body.

        Offline: every button here carries `data-available-offline`, so the framework offline UI
        leaves navigation (prev/next), Add and Back usable. Load more is rendered online only, so
        offline no uncached read is attempted. The attribute is inert online.
    -->
    <t t-name="crm.CrmMobilePipeline">
        <t t-if="this.isMobilePipeline">
            <t t-set="group" t-value="this.currentGroup"/>
            <div class="o_kanban_renderer o_renderer o_kanban_grouped o_crm_mobile_pipeline d-flex flex-column user-select-none" t-ref="this.rootRef">
                <div class="o_crm_mobile_pipeline_header d-flex align-items-center gap-1 px-2 py-1 bg-view border-bottom">
                    <button t-if="this.hasPrevStage" type="button"
                        class="btn btn-light o_crm_mobile_pipeline_prev"
                        data-available-offline="1"
                        aria-label="Previous stage"
                        title="Previous stage"
                        t-on-click="() => this.onPrev()">
                        <i class="oi" data-icon="chevron_backward" aria-hidden="true"/>
                    </button>
                    <div class="o_crm_mobile_pipeline_title flex-grow-1 min-w-0 text-center" aria-live="polite">
                        <div class="o_crm_mobile_pipeline_stage_name fw-bold text-truncate">
                            <i t-if="group.isFolded" class="oi me-1 o_crm_mobile_pipeline_folded" data-icon="close_fullscreen" role="img" aria-label="Folded" title="Folded"/>
                            <t t-out="group.displayName"/>
                        </div>
                        <div class="o_crm_mobile_pipeline_totals small text-muted text-truncate">
                            <span class="visually-hidden">Leads:</span>
                            <span class="o_crm_mobile_pipeline_count" title="Leads" t-out="this.stageCount(group)"/>
                            <t t-if="this.hasRevenue">
                                <span class="mx-1" aria-hidden="true">•</span>
                                <span class="visually-hidden">Expected revenue:</span>
                                <span class="o_crm_mobile_pipeline_revenue" title="Expected revenue" t-out="this.formatStageRevenue(group)"/>
                            </t>
                        </div>
                    </div>
                    <button t-if="this.hasNextStage" type="button"
                        class="btn btn-light o_crm_mobile_pipeline_next"
                        data-available-offline="1"
                        aria-label="Next stage"
                        title="Next stage"
                        t-on-click="() => this.onNext()">
                        <i class="oi" data-icon="chevron_forward" aria-hidden="true"/>
                    </button>
                    <button t-if="this.canAdd" type="button"
                        class="btn btn-primary o_crm_mobile_pipeline_add"
                        data-available-offline="1"
                        aria-label="New Lead"
                        title="New Lead"
                        t-on-click="(ev) => this.onAddClick(ev)">
                        <i class="oi" data-icon="add_2" aria-hidden="true"/>
                    </button>
                </div>

                <div class="o_kanban_group o_crm_mobile_pipeline_body"
                    role="region"
                    t-att-aria-label="group.displayName"
                    t-att-data-id="group.id"
                    t-key="'stage_' + group.serverValue"
                    t-on-touchstart="(ev) => this.onTouchStart(ev)"
                    t-on-touchmove="(ev) => this.onTouchMove(ev)"
                    t-on-touchend="(ev) => this.onTouchEnd(ev)">
                    <!--
                        A lead whose form is not available offline was tapped. Back takes the focus
                        and is described by the helper's sentence, so the reason is announced with
                        it. The description is a hidden copy of that sentence: the helper markup
                        also holds an icon whose ligature text and a Reset Filters button would be
                        read into it. A reload keeps this stage body (keyed by stage), Back and the
                        helper, so the focus stays where it was. The helper carries the body's key
                        because component keys are scoped to this template, not to the body's
                        t-key: when the body is rebuilt for another stage while the helper shows,
                        a keyless helper would be handed from the old body to the new one, which
                        Owl cannot mount.
                    -->
                    <t t-if="this.mobileState.unavailableLeadId">
                        <div class="d-flex justify-content-center py-2">
                            <button type="button"
                                class="btn btn-secondary o_crm_mobile_pipeline_back"
                                data-available-offline="1"
                                aria-label="Back"
                                title="Back"
                                aria-describedby="o_crm_mobile_pipeline_unavailable_help"
                                t-ref="this.backRef"
                                t-on-click="() => this.onBackFromHelper()">
                                <i class="oi me-1" data-icon="arrow_back" aria-hidden="true"/> Back
                            </button>
                            <span id="o_crm_mobile_pipeline_unavailable_help" hidden="">There is no data to display offline for the given filters</span>
                        </div>
                        <OfflineActionHelper t-key="'stage_' + group.serverValue"/>
                    </t>
                    <t t-else="">
                        <!-- Framework quick create (New), props as in web.KanbanRenderer. -->
                        <t t-if="this.props.quickCreateState and group.id === this.props.quickCreateState.id">
                            <KanbanRecordQuickCreate
                                quickCreateState="this.props.quickCreateState"
                                onValidate="(record, mode) => this.validateQuickCreate(record, mode, group)"
                                resModel="group.resModel"
                                context="group.context"
                            />
                        </t>
                        <!-- One ordered stage array, shared by every card of both loops. -->
                        <t t-set="stages" t-value="this.stageGroups"/>
                        <!-- Queued lead creates, keyed by queue key: they leave with their entry. -->
                        <t t-foreach="this.pendingCreatesFor(group)" t-as="entry" t-key="entry.key">
                            <CrmMobileLeadCard
                                pendingCall="entry"
                                group="group"
                                stages="stages"
                                displayedStageValue="group.serverValue"
                            />
                        </t>
                        <!--
                            Records placed in this stage, queued stage writes included. The key
                            carries the stage: component keys are scoped to this template, not to
                            the stage body's t-key, and a card move renders the moved record in
                            the old and the new stage body in one patch. With the record id alone
                            both cards would share one key and the moved card would stop
                            reacting to its own state (stage list, follow-up, activities).
                        -->
                        <t t-foreach="this.cardsFor(group)" t-as="record" t-key="group.id + ':' + record.id">
                            <CrmMobileLeadCard
                                record="record"
                                group="group"
                                stages="stages"
                                activities="this.mobileState.activitiesByLead[record.resId] ?? null"
                                activityTotal="this.mobileState.activityTotalsByLead[record.resId] ?? null"
                                onShowAllActivities="(resId) => this.onShowAllActivities(resId)"
                                activityTypes="this.mobileState.activityTypes"
                                unavailable="this.isCardUnavailable(record)"
                                displayedStageValue="group.serverValue"
                                frameworkStageValue="record.group?.serverValue"
                                onOpen="(r) => this.onCardOpen(r)"
                                onMove="(r, targetGroup) => this.onCardMove(r, targetGroup)"
                                onActivitiesChanged="(resId) => this.onActivitiesChanged(resId)"
                            />
                        </t>
                        <!--
                            Offline, the stage holds leads none of which was loaded online. Keyed
                            like the stage body, for the reason given for the unavailable-lead
                            helper: moving between two such stages rebuilds the body with this
                            helper in both, while a reload keeps the body and the helper.
                        -->
                        <OfflineActionHelper t-if="this.isStageDataMissing(group)" t-key="'stage_' + group.serverValue"/>
                        <t t-set="unavailableCount" t-value="this.unavailableMoreCount(group)"/>
                        <div t-if="unavailableCount > 0"
                            class="o_crm_mobile_pipeline_unavailable_more text-muted small text-center py-2"
                            t-out="this.unavailableMoreLabel(group, unavailableCount)"/>
                        <!-- Online only: offline, no uncached read is attempted. -->
                        <t t-if="!this.crmOffline.isOffline()">
                            <t t-set="unloadedCount" t-value="this.getGroupUnloadedCount(group)"/>
                            <div t-if="unloadedCount > 0" class="o_kanban_load_more o_crm_mobile_pipeline_load_more" t-key="unloadedCount">
                                <!-- Busy and disabled while its load is in flight. -->
                                <button t-if="group.isFolded" type="button"
                                    class="btn btn-outline-primary w-100 mt-3"
                                    data-available-offline="1"
                                    t-att-disabled="this.isLoadingMore(group)"
                                    t-att-aria-busy="this.isLoadingMore(group) ? 'true' : 'false'"
                                    t-on-click="() => this.onLoadMoreClick(group)"><i t-if="this.isLoadingMore(group)" class="oi oi-spin me-1" data-icon="autorenew" aria-hidden="true"/>Load more... (<t t-out="unloadedCount"/> remaining)</button>
                                <button t-else="" type="button"
                                    class="btn btn-outline-primary w-100 mt-3"
                                    data-available-offline="1"
                                    t-att-disabled="this.isLoadingMore(group)"
                                    t-att-aria-busy="this.isLoadingMore(group) ? 'true' : 'false'"
                                    t-on-click="() => this.onLoadMoreClick(group)"><i t-if="this.isLoadingMore(group)" class="oi oi-spin me-1" data-icon="autorenew" aria-hidden="true"/>Load more... (<t t-out="unloadedCount"/> remaining)</button>
                            </div>
                        </t>
                    </t>
                </div>

                <t t-if="this.showNoContentHelper">
                    <ActionHelper noContentHelp="this.props.noContentHelp"/>
                </t>
            </div>
        </t>
        <t t-else="" t-call="web.KanbanRenderer"/>
    </t>

</templates>
