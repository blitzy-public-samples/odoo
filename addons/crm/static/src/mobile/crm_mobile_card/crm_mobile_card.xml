<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- VAL-MOBILE-007: name, partner name, expected revenue, pending-sync
         badge. The whole card is the single ≥44x44 CSS px touch target
         (`min-height`/`min-width` set inline so the size holds regardless
         of whether crm_mobile_card.scss has loaded yet; that file repeats
         the same rule for the real, styled card). `o_kanban_record` is
         kept on the root so this card keeps the framework's generic
         kanban-card styling (background, spacing) and its keyboard
         navigation (`kanban_renderer.js`'s arrow/Enter hotkeys look for
         that class, not for the `KanbanRecord` component specifically). -->
    <t t-name="crm.CrmMobileCard">
        <div class="o_kanban_record o_kanban_global_click o_crm_mobile_card d-flex flex-column justify-content-center gap-1 p-2"
            style="min-height: 44px; min-width: 44px;"
            tabindex="0"
            t-on-click="this.onClick"
        >
            <div class="d-flex align-items-start justify-content-between gap-2">
                <span class="o_crm_mobile_card_name fw-bold d-block text-truncate" t-out="this.record.data.name"/>
                <span t-if="this.isPendingSync" class="o_crm_mobile_card_pending_sync badge text-bg-warning flex-shrink-0">Pending sync</span>
            </div>
            <div t-if="this.partnerName" class="o_crm_mobile_card_partner d-block text-truncate text-muted" t-out="this.partnerName"/>
            <div t-if="this.expectedRevenueText" class="o_crm_mobile_card_revenue fw-semibold" t-out="this.expectedRevenueText"/>
            <!-- orchestrator-triage.md blocker 7 (VAL-MOBILE-017): one
                 star per priority option above "Low", each its own
                 ≥44x44 CSS px button (inline size, belt-and-suspenders
                 with crm_mobile_card.scss like the card root above) with
                 `data-available-offline` on the button itself so the
                 framework doesn't disable it offline, and
                 `t-on-click.stop` so tapping a star updates the priority
                 instead of triggering the card's own `onClick`. -->
            <div t-if="this.hasPriority" class="o_crm_mobile_card_priority d-flex" role="radiogroup" aria-label="Priority">
                <t t-foreach="this.priorityStars" t-as="star" t-key="star.value">
                    <button type="button"
                        class="o_crm_mobile_card_priority_star btn btn-link p-0 d-flex align-items-center justify-content-center oi"
                        t-att-class="{'oi-filled': star.active}"
                        style="min-height: 44px; min-width: 44px;"
                        data-icon="star"
                        data-available-offline=""
                        role="radio"
                        t-att-aria-checked="star.checked ? 'true' : 'false'"
                        t-att-aria-label="star.label"
                        t-att-data-tooltip="star.label"
                        t-on-click.stop="() => this.onPriorityClick(star.value)"
                    />
                </t>
            </div>
        </div>
    </t>

</templates>
