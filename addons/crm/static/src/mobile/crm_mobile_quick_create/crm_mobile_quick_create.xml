<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        - Values are bound with `t-model.proxy`, because the component state is a `proxy`; a plain
          `t-model` expects a signal. The stage options' values are group datapoint ids (strings),
          as `state.stageGroupId` is, so the select's strict comparison selects the right option.
        - The expected revenue is bound one way (`onRevenueInput`): a number input reports an empty
          value for a text it cannot parse (`1e`), and writing that value back would erase the text
          and its `badInput` state, which `save()` reads to reject it.
        - Every interactive element carries `data-available-offline`: the framework offline UI
          disables each `<button>` without it, and the sheet must stay usable offline.
        - No `<form>` wrapper and only `type="button"` buttons, so `save()` is the sole create path.
          The framework classes `o_kanban_quick_create` and `o_kanban_add` are not used: they belong
          to the framework kanban quick create, which the upstream mobile main-flow tour drives.
        - Comments stay outside the template: Owl renders a comment inside a template into the DOM.
    -->
    <t t-name="crm.CrmMobileQuickCreate">
        <div class="o_crm_mobile_quick_create d-flex flex-column gap-3 p-3">
            <h4 class="mb-0">New Lead</h4>

            <div class="o_crm_mobile_quick_create_field">
                <label class="form-label" for="o_crm_mobile_quick_create_name">Lead Name</label>
                <input id="o_crm_mobile_quick_create_name"
                    type="text"
                    name="name"
                    class="form-control rounded"
                    required="1"
                    t-ref="this.nameRef"
                    t-model.proxy="this.state.name"
                    t-att-aria-invalid="this.state.errors.name ? 'true' : false"
                    t-att-aria-describedby="this.state.errors.name ? 'o_crm_mobile_quick_create_name_error' : false"
                    data-available-offline="1"/>
                <div t-if="this.state.errors.name"
                    id="o_crm_mobile_quick_create_name_error"
                    class="text-danger-emphasis small"
                    role="alert"
                    t-out="this.state.errors.name"/>
            </div>

            <div class="o_crm_mobile_quick_create_field">
                <label class="form-label" for="o_crm_mobile_quick_create_contact_name">Contact Name</label>
                <input id="o_crm_mobile_quick_create_contact_name"
                    type="text"
                    name="contact_name"
                    class="form-control rounded"
                    t-model.proxy="this.state.contact_name"
                    data-available-offline="1"/>
            </div>

            <div class="o_crm_mobile_quick_create_field">
                <label class="form-label" for="o_crm_mobile_quick_create_phone">Phone</label>
                <input id="o_crm_mobile_quick_create_phone"
                    type="tel"
                    name="phone"
                    class="form-control rounded"
                    t-model.proxy="this.state.phone"
                    data-available-offline="1"/>
            </div>

            <div class="o_crm_mobile_quick_create_field">
                <label class="form-label" for="o_crm_mobile_quick_create_email_from">Email</label>
                <input id="o_crm_mobile_quick_create_email_from"
                    type="email"
                    name="email_from"
                    class="form-control rounded"
                    t-model.proxy="this.state.email_from"
                    t-att-aria-invalid="this.state.errors.email_from ? 'true' : false"
                    t-att-aria-describedby="this.state.errors.email_from ? 'o_crm_mobile_quick_create_email_from_error' : false"
                    data-available-offline="1"/>
                <div t-if="this.state.errors.email_from"
                    id="o_crm_mobile_quick_create_email_from_error"
                    class="text-danger-emphasis small"
                    role="alert"
                    t-out="this.state.errors.email_from"/>
            </div>

            <div class="o_crm_mobile_quick_create_field">
                <label class="form-label" for="o_crm_mobile_quick_create_expected_revenue">Expected Revenue</label>
                <input id="o_crm_mobile_quick_create_expected_revenue"
                    type="number"
                    inputmode="decimal"
                    step="any"
                    min="0"
                    name="expected_revenue"
                    class="form-control rounded"
                    t-on-input="(ev) => this.onRevenueInput(ev)"
                    t-ref="this.revenueRef"
                    t-att-aria-invalid="this.state.errors.expected_revenue ? 'true' : false"
                    t-att-aria-describedby="this.state.errors.expected_revenue ? 'o_crm_mobile_quick_create_expected_revenue_error' : false"
                    data-available-offline="1"/>
                <div t-if="this.state.errors.expected_revenue"
                    id="o_crm_mobile_quick_create_expected_revenue_error"
                    class="text-danger-emphasis small"
                    role="alert"
                    t-out="this.state.errors.expected_revenue"/>
            </div>

            <div class="o_crm_mobile_quick_create_field">
                <label class="form-label" for="o_crm_mobile_quick_create_stage_id">Stage</label>
                <select id="o_crm_mobile_quick_create_stage_id"
                    name="stage_id"
                    class="form-select"
                    t-model.proxy="this.state.stageGroupId"
                    data-available-offline="1">
                    <option t-foreach="this.stageGroups" t-as="group" t-key="group.id"
                        t-att-value="group.id"
                        t-out="group.displayName"/>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                    class="btn btn-primary flex-grow-1 o_crm_mobile_quick_create_save"
                    data-available-offline="1"
                    t-att-disabled="this.state.saving"
                    t-on-click="() => this.save()">
                    Save
                </button>
                <button type="button"
                    class="btn btn-secondary flex-grow-1 o_crm_mobile_quick_create_discard"
                    data-available-offline="1"
                    t-on-click="() => this.discard()">
                    Discard
                </button>
            </div>
        </div>
    </t>

</templates>
