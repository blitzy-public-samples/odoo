<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- VAL-MOBILE-009: exactly six field controls (name, contact_name,
         phone, email, expected revenue, stage), no other input, plus
         the save control, each carrying `data-available-offline` on the
         interactive element itself: this sheet's whole point is the
         offline create path (VAL-MOBILE-010), so every control in it must
         stay reachable while offline, including Cancel (so the user can
         still dismiss the sheet without reconnecting). -->
    <t t-name="crm.CrmMobileQuickCreate">
        <div class="o_crm_mobile_quick_create d-flex flex-column gap-2">
            <div class="d-flex align-items-center justify-content-between">
                <h6 class="mb-0">New Lead</h6>
                <button type="button" class="btn btn-sm btn-light o_crm_mobile_quick_create_cancel"
                    data-available-offline=""
                    t-on-click="this.onCancel"
                >
                    <i class="oi" data-icon="close" role="img" aria-label="Cancel" title="Cancel"/>
                </button>
            </div>
            <input type="text" placeholder="Lead name" class="form-control o_crm_mobile_quick_create_name"
                data-available-offline=""
                t-model="this.name"
                t-att-disabled="this.isSaving()"
            />
            <input type="text" placeholder="Contact name" class="form-control o_crm_mobile_quick_create_contact_name"
                data-available-offline=""
                t-model="this.contactName"
                t-att-disabled="this.isSaving()"
            />
            <input type="tel" placeholder="Phone" class="form-control o_crm_mobile_quick_create_phone"
                data-available-offline=""
                t-model="this.phone"
                t-att-disabled="this.isSaving()"
            />
            <input type="email" placeholder="Email" class="form-control o_crm_mobile_quick_create_email"
                data-available-offline=""
                t-model="this.email"
                t-att-disabled="this.isSaving()"
            />
            <input type="number" step="0.01" placeholder="Expected revenue" class="form-control o_crm_mobile_quick_create_expected_revenue"
                data-available-offline=""
                t-model.number="this.expectedRevenue"
                t-att-disabled="this.isSaving()"
            />
            <select class="form-select o_crm_mobile_quick_create_stage"
                data-available-offline=""
                t-model.number="this.stageId"
                t-att-disabled="this.isSaving()"
            >
                <option t-foreach="this.props.stages" t-as="stage" t-key="stage.id"
                    t-att-value="stage.id" t-esc="stage.displayName"/>
            </select>
            <button type="button" class="btn btn-primary o_crm_mobile_quick_create_save"
                data-available-offline=""
                t-att-disabled="!this.canSave"
                t-on-click="this.onSave"
            >Create</button>
        </div>
    </t>

</templates>
