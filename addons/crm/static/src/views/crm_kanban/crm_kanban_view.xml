<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="crm.Kanban.Buttons" t-inherit="web.KanbanView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <t t-if="this.env.searchModel.context.show_lead_gen_button">
                <LeadGenerationDropdown/>
            </t>
        </xpath>
    </t>

    <!-- Uncached lead opened offline (architecture.md §3.2 item 10): a
         primary inheritance of "web.KanbanView" scoped to crm_kanban only,
         so every other kanban view keeps the base template untouched. -->
    <t t-name="crm.KanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="attributes">
            <attribute name="t-if">this.model.isReady() and !(this.offlineUncachedClick() and this.crmOffline.isOffline())</attribute>
        </xpath>
        <xpath expr="//t[@t-component='this.props.Renderer']" position="before">
            <t t-if="this.offlineUncachedClick() and this.crmOffline.isOffline()">
                <OfflineActionHelper/>
            </t>
        </xpath>
    </t>
</templates>
